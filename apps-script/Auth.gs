/* GOOGLE_CLIENT_ID is configured in Script Properties, never accepted from a caller. */
function googleIdentity_(token) {
  const clientId = PropertiesService.getScriptProperties().getProperty('GOOGLE_CLIENT_ID');
  assert_(clientId, 'ระบบเข้าสู่ระบบยังไม่ได้ตั้งค่า');
  const cache = CacheService.getScriptCache();
  const cacheKey = 'google-jwks-v1';
  function fetchKeys() {
    const response = UrlFetchApp.fetch('https://www.googleapis.com/oauth2/v3/certs', {muteHttpExceptions: true, followRedirects: false});
    assert_(response.getResponseCode() === 200, 'ไม่สามารถตรวจสอบบัญชี Google ได้');
    const text = response.getContentText();
    const keys = JSON.parse(text);
    assert_(Array.isArray(keys.keys) && keys.keys.length > 0, 'ไม่สามารถตรวจสอบบัญชี Google ได้');
    cache.put(cacheKey, text, 300);
    return keys;
  }
  let keys;
  try { keys = JSON.parse(cache.get(cacheKey) || 'null'); } catch (_) { keys = null; }
  if (!keys) keys = fetchKeys();
  try { return GoogleTokenVerifier.verifyGoogleIdToken(token, clientId, keys); }
  catch (error) {
    if (String(error.message) !== 'Unknown signing key') throw error;
    return GoogleTokenVerifier.verifyGoogleIdToken(token, clientId, fetchKeys());
  }
}

function actorForIdentity_(db, identity) {
  const users = rows_(db, 'Users');
  let user = users.find(u => u.google_sub === identity.sub);
  if (user) { assert_(active_(user), 'บัญชีนี้ถูกระงับ'); return user; }
  user = users.find(u => String(u.email).toLowerCase() === identity.email);
  if (!user) return null;
  assert_(active_(user) && !user.google_sub, 'บัญชีนี้ไม่สามารถเข้าใช้งานได้');
  const domain = identity.email.split('@').pop();
  assert_(domain === 'gmail.com' || (identity.hosted_domain && identity.hosted_domain === domain), 'ไม่สามารถยืนยันบัญชีที่กำหนดล่วงหน้าได้');
  user.google_sub = identity.sub;
  save_(db, 'Users', user);
  return user;
}

// Session secrets are generated by the browser with crypto.getRandomValues.
// Only their SHA-256 hashes are stored in the private owner spreadsheet.
function sessionHash_(token) {
  assert_(typeof token==='string' && /^vivo1\.[A-Za-z0-9_-]{43}$/.test(token),'เซสชันไม่ถูกต้อง');
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256,token,Utilities.Charset.UTF_8).map(b=>('0'+(b&255).toString(16)).slice(-2)).join('');
}
function sessionSheet_(db) {
  let sheet=db.getSheetByName('Sessions');
  if (!sheet) {
    sheet=db.insertSheet('Sessions');
    sheet.getRange(1,1,1,4).setValues([['session_hash','user_id','expires_at','revoked']]);
    sheet.setFrozenRows(1);
    sheet.protect().setDescription('Application sessions: managed by the dashboard');
  }
  return sheet;
}
function sessionActor_(db,token,now) {
  sessionSheet_(db);
  const hash=sessionHash_(token);
  const session=rows_(db,'Sessions').find(s=>s.session_hash===hash);
  assert_(session && !active_({active:session.revoked}),'SESSION_INVALID');
  const actor=rows_(db,'Users').find(u=>u.user_id===session.user_id && active_(u));
  assert_(actor && actor.google_sub,'SESSION_INVALID');
  return actor;
}
function startSession_(db,actor,secret,now) {
  assert_(actor && active_(actor),'บัญชีนี้ยังไม่ได้รับสิทธิ์');
  sessionSheet_(db);
  const hash=sessionHash_(secret);
  assert_(!rows_(db,'Sessions').some(s=>s.session_hash===hash),'เซสชันซ้ำ');
  save_(db,'Sessions',{session_hash:hash,user_id:actor.user_id,expires_at:'',revoked:false});
  return {created:true};
}
function endSession_(db,token) {
  sessionSheet_(db);
  const hash=sessionHash_(token), session=rows_(db,'Sessions').find(s=>s.session_hash===hash);
  if (session) { session.revoked=true; save_(db,'Sessions',session); }
  return {done:true};
}

function authenticatedApi(token, action, payload) {
  const lock = LockService.getScriptLock();
  try {
    const isSession=typeof token==='string' && token.startsWith('vivo1.');
    const identity=isSession ? null : googleIdentity_(token);
    lock.waitLock(30000);
    try {
      const db = database_(), p = payload || {}, now = new Date();
      const actor = isSession ? sessionActor_(db,token,now) : actorForIdentity_(db,identity);
      let result;
      if (action === 'startSession') {
        assert_(!isSession,'กรุณาเข้าสู่ระบบด้วย Google');
        result=startSession_(db,actor,p.secret,now);
      } else if (action === 'endSession') {
        assert_(isSession,'เซสชันไม่ถูกต้อง');
        result=endSession_(db,token);
      } else if (action === 'identityStatus') {
        const pending = !actor && rows_(db,'Registrations').some(r => r.google_sub === identity.sub && r.status === 'PENDING');
        result = {status: actor ? 'ACTIVE' : pending ? 'PENDING' : 'NEW'};
        if (actor && !isSession && p.secret) {
          const data = bootstrap_(db,actor,{month:p.month,static_catalog:p.static_catalog},now);
          startSession_(db,actor,p.secret,now);
          result.data = data;
        }
      } else if (action === 'registrationManagers') {
        assert_(!actor, 'บัญชีนี้มีสิทธิ์เข้าใช้งานแล้ว');
        result = rows_(db,'Users').filter(u => u.role === 'MANAGER' && active_(u) && u.family_id).map(u => ({id:u.user_id,name:u.name}));
      } else if (action === 'register') {
        assert_(!actor, 'บัญชีนี้มีสิทธิ์เข้าใช้งานแล้ว');
        result = submitRegistration_(db, identity, p, now);
      } else {
        assert_(actor, 'บัญชีนี้ยังไม่ได้รับสิทธิ์');
        result = dispatch_(db, actor, action, p, now);
      }
      SpreadsheetApp.flush();
      return JSON.parse(JSON.stringify({ok:true,data:result}));
    } finally { lock.releaseLock(); }
  } catch (error) {
    // Only a known session rejection is exposed; never return internal details.
    if (String(error.message)==='SESSION_INVALID') return {ok:false,code:'SESSION_INVALID',error:'เซสชันหมดอายุหรือบัญชีถูกระงับ กรุณาเข้าสู่ระบบใหม่'};
    return {ok:false,error:'ไม่สามารถยืนยันตัวตนหรือทำรายการได้ กรุณาตรวจสอบข้อมูลและลองอีกครั้ง'};
  }
}
